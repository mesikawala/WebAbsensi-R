---
/**
 * @file src/pages/rekapitulasi.astro
 * @description Halaman Rekapitulasi Presensi & Ekspor Laporan PDF Standar Dinas
 * Didesain ulang dengan tata letak modular menggunakan Sidebar Khusus (seperti profil civitas)
 * agar setiap fitur (Statistik, Dokumen Sah PDF, Riwayat Log Turso, dan Otomatisasi) terorganisir rapi tanpa sesak.
 */
export const prerender = false;

const authSession = Astro.cookies.get('auth_session')?.value;
if (!authSession) {
  return Astro.redirect('/login');
}
if (authSession === 'siswa') {
  return Astro.redirect('/profil-siswa');
}

import Layout from '../layouts/Layout.astro';
---

<Layout title="Rekapitulasi & PDF" activeNav="rekap">

  <!-- ========================================================
       1. SIDEBAR KHUSUS REKAPITULASI & EKSPOR LAPORAN
       (Menggantikan Sidebar Utama via slot="sidebar")
       ======================================================== -->
  <aside
    slot="sidebar"
    class="w-full md:w-64 lg:w-72 bg-gradient-to-b from-[#1e3a8a] via-[#1d4ed8] to-[#1e40af] text-blue-100 flex flex-col justify-between shrink-0 select-none shadow-xl border-r border-blue-900/40 overflow-y-auto h-auto min-h-[920px] p-5 space-y-6"
    aria-label="Sidebar Khusus Rekapitulasi & Laporan"
  >
    <div class="space-y-6">
      <!-- Tombol Kembali ke Dashboard Utama -->
      <div class="pb-3 border-b border-white/15">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-2xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition duration-200 hover:scale-[1.02] active:scale-[0.98] w-full border border-white/15 shadow-sm"
          title="Kembali ke Dashboard Utama"
        >
          <span class="material-symbols-outlined text-base">arrow_back</span>
          <span>Kembali ke Menu Utama</span>
        </a>
      </div>

      <!-- Header Info Modul Rekapitulasi di Sidebar -->
      <div class="p-3.5 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 space-y-2.5">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center text-white shadow-md">
            <span class="material-symbols-outlined text-2xl">description</span>
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="font-black text-sm text-white truncate">Rekap Presensi</h3>
            <p class="text-[11px] font-semibold text-blue-200 truncate">SMK Ma'arif Padang Ratu</p>
          </div>
        </div>

        <div class="pt-2 border-t border-white/10 space-y-1 text-[11px]">
          <div class="flex items-center justify-between">
            <span class="text-blue-200">Database:</span>
            <span class="px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 font-bold">Online</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-blue-200">Reset Harian:</span>
            <span class="px-2 py-0.5 rounded-md bg-indigo-500/20 text-indigo-300 border border-indigo-400/30 font-bold">23:00 WIB</span>
          </div>
        </div>
      </div>

      <!-- Navigasi Menu Modular Rekapitulasi -->
      <nav class="space-y-1.5" id="rekap-subnav" aria-label="Navigasi Menu Rekapitulasi">
        <!-- 1. Statistik Kehadiran -->
        <button
          type="button"
          data-target="sec-statistik"
          data-title="Statistik Kehadiran"
          data-desc="Data presensi hari ini tersinkronisasi otomatis dengan sensor RFID gerbang."
          class="rekap-nav-btn active w-full flex items-center justify-between px-3.5 py-3 rounded-2xl text-xs font-bold transition duration-200 text-left cursor-pointer bg-white text-blue-900 shadow-lg shadow-blue-950/25 border-l-4 border-indigo-700 translate-x-1"
        >
          <span class="flex items-center gap-3">
            <span class="material-symbols-outlined text-lg">query_stats</span>
            <span>Statistik</span>
          </span>
          <span class="material-symbols-outlined text-sm opacity-80">chevron_right</span>
        </button>

        <!-- 2. Dokumen Sah & Cetak PDF -->
        <button
          type="button"
          data-target="sec-dokumen"
          data-title="Dokumen & Cetak PDF"
          data-desc="Laporan berita acara presensi resmi, siap dicetak ke format PDF."
          class="rekap-nav-btn w-full flex items-center justify-between px-3.5 py-3 rounded-2xl text-xs font-semibold transition duration-200 text-left cursor-pointer text-blue-100/80 hover:text-white hover:bg-white/15 hover:translate-x-0.5"
        >
          <span class="flex items-center gap-3">
            <span class="material-symbols-outlined text-lg">picture_as_pdf</span>
            <span>Dokumen & PDF</span>
          </span>
          <span class="material-symbols-outlined text-sm opacity-60">chevron_right</span>
        </button>

        <!-- 3. Riwayat Presensi & Arsip Log -->
        <button
          type="button"
          data-target="sec-riwayat"
          data-title="Riwayat Presensi & Log"
          data-desc="Catatan presensi realtime dan arsip historis dari database cloud."
          class="rekap-nav-btn w-full flex items-center justify-between px-3.5 py-3 rounded-2xl text-xs font-semibold transition duration-200 text-left cursor-pointer text-blue-100/80 hover:text-white hover:bg-white/15 hover:translate-x-0.5"
        >
          <span class="flex items-center gap-3">
            <span class="material-symbols-outlined text-lg">table_chart</span>
            <span>Riwayat & Log</span>
          </span>
          <span class="material-symbols-outlined text-sm opacity-60">chevron_right</span>
        </button>

        <!-- 4. Otomatisasi & Kontrol Operasional -->
        <button
          type="button"
          data-target="sec-otomatisasi"
          data-title="Pusat Otomatisasi"
          data-desc="Kontrol evaluasi bolos kepulangan (-10 poin) dan jadwal arsip harian 23:00 WIB."
          class="rekap-nav-btn w-full flex items-center justify-between px-3.5 py-3 rounded-2xl text-xs font-semibold transition duration-200 text-left cursor-pointer text-blue-100/80 hover:text-white hover:bg-white/15 hover:translate-x-0.5"
        >
          <span class="flex items-center gap-3">
            <span class="material-symbols-outlined text-lg">tune</span>
            <span>Otomatisasi</span>
          </span>
          <span class="material-symbols-outlined text-sm opacity-60">chevron_right</span>
        </button>
      </nav>
    </div>

    <!-- Quick Footer Actions di Sidebar -->
    <div class="pt-4 border-t border-white/15 space-y-2">
      <button
        type="button"
        id="sidebar-btn-wa"
        class="w-full flex items-center justify-center gap-2 py-2 px-3 rounded-xl bg-emerald-600/80 hover:bg-emerald-600 text-white font-bold text-xs transition duration-200 shadow-sm cursor-pointer hover:scale-[1.02] active:scale-[0.98]"
        title="Salin ringkasan presensi untuk dikirim ke grup WhatsApp"
      >
        <span class="material-symbols-outlined text-base">chat</span>
        <span>Salin Ringkasan WA</span>
      </button>
      <button
        type="button"
        id="sidebar-btn-excel"
        class="w-full flex items-center justify-center gap-2 py-2 px-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition duration-200 border border-white/15 cursor-pointer hover:scale-[1.02] active:scale-[0.98]"
        title="Unduh seluruh data log terfilter dalam format Excel (CSV)"
      >
        <span class="material-symbols-outlined text-base">table_view</span>
        <span>Unduh Excel (CSV)</span>
      </button>
    </div>
  </aside>

  <!-- ========================================================
       2. TAMPILAN KONTEN UTAMA (MODULAR & RAPI)
       ======================================================== -->
  <div class="print:hidden flex flex-col gap-6 max-w-7xl mx-auto w-full">
    
    <!-- Top Action Bar & Header Ramping (Ultra Clean & Professional) -->
    <div class="p-5 sm:p-6 bg-white/90 backdrop-blur-xl rounded-3xl shadow-xs border border-slate-200/80 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-blue-50 border border-blue-200/60 text-[11px] font-bold text-blue-700 mb-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
          <span>Laporan Presensi Resmi</span>
        </div>
        <h1 id="rekap-current-tab-title" class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
          Statistik Kehadiran Civitas
        </h1>
        <p id="rekap-current-tab-desc" class="text-xs text-slate-500 mt-0.5">
          Ringkasan metrik presensi hari ini tersinkronisasi otomatis dengan sensor RFID & gerbang IoT.
        </p>
      </div>

    </div>

    <!-- ========================================================
         SECTION 1: STATISTIK KEHADIRAN (BERSIH & LEGA)
         ======================================================== -->
    <section id="sec-statistik" class="rekap-section space-y-6">
      <!-- 6 Metric Cards Solid Bergaya HeiMaUX (Sesuai Dashboard Utama) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5">
        <!-- Hadir Tepat (Solid Vivid Emerald) -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white p-4 shadow-lg shadow-emerald-500/25 border border-emerald-400/30 flex flex-col justify-between transition-all duration-200 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-emerald-100 uppercase tracking-wider">Hadir Tepat</span>
            <div class="w-7 h-7 rounded-lg bg-white/20 backdrop-blur-xs flex items-center justify-center text-white border border-white/25">
              <span class="material-symbols-outlined text-[16px]">check_circle</span>
            </div>
          </div>
          <p class="text-3xl font-black text-white tracking-tight" id="rekap-hadir">0</p>
        </div>

        <!-- Terlambat (Solid Amber / Orange) -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-amber-500 to-orange-500 text-white p-4 shadow-lg shadow-amber-500/25 border border-amber-400/30 flex flex-col justify-between transition-all duration-200 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-amber-100 uppercase tracking-wider">Terlambat</span>
            <div class="w-7 h-7 rounded-lg bg-white/20 backdrop-blur-xs flex items-center justify-center text-white border border-white/25">
              <span class="material-symbols-outlined text-[16px]">schedule</span>
            </div>
          </div>
          <p class="text-3xl font-black text-white tracking-tight" id="rekap-terlambat">0</p>
        </div>

        <!-- Bolos (-10P) (Solid Rose / Red) -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-rose-500 to-red-600 text-white p-4 shadow-lg shadow-rose-500/25 border border-rose-400/30 flex flex-col justify-between transition-all duration-200 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-rose-100 uppercase tracking-wider">Bolos (-10P)</span>
            <div class="w-7 h-7 rounded-lg bg-white/20 backdrop-blur-xs flex items-center justify-center text-white border border-white/25">
              <span class="material-symbols-outlined text-[16px]">dangerous</span>
            </div>
          </div>
          <p class="text-3xl font-black text-white tracking-tight" id="rekap-bolos">0</p>
        </div>

        <!-- Izin / Disp (Solid Indigo / Violet) -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-500 to-purple-600 text-white p-4 shadow-lg shadow-indigo-500/25 border border-indigo-400/30 flex flex-col justify-between transition-all duration-200 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-indigo-100 uppercase tracking-wider">Izin / Disp</span>
            <div class="w-7 h-7 rounded-lg bg-white/20 backdrop-blur-xs flex items-center justify-center text-white border border-white/25">
              <span class="material-symbols-outlined text-[16px]">assignment_turned_in</span>
            </div>
          </div>
          <p class="text-3xl font-black text-white tracking-tight" id="rekap-izin">0</p>
        </div>

        <!-- Sudah Pulang (Solid Vivid Blue) -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#2f69ff] to-[#4581ff] text-white p-4 card-glow-blue border border-blue-400/30 flex flex-col justify-between transition-all duration-200 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-blue-100 uppercase tracking-wider">Sudah Pulang</span>
            <div class="w-7 h-7 rounded-lg bg-white/20 backdrop-blur-xs flex items-center justify-center text-white border border-white/25">
              <span class="material-symbols-outlined text-[16px]">logout</span>
            </div>
          </div>
          <p class="text-3xl font-black text-white tracking-tight" id="rekap-pulang">0</p>
        </div>

        <!-- Belum Absen (Solid Slate) -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#64748b] to-[#475569] text-white p-4 shadow-lg shadow-slate-700/25 border border-slate-500/30 flex flex-col justify-between transition-all duration-200 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-slate-200 uppercase tracking-wider">Belum Absen</span>
            <div class="w-7 h-7 rounded-lg bg-white/20 backdrop-blur-xs flex items-center justify-center text-white border border-white/25">
              <span class="material-symbols-outlined text-[16px]">person_off</span>
            </div>
          </div>
          <p class="text-3xl font-black text-white tracking-tight" id="rekap-belum">0</p>
        </div>
      </div>

      <!-- 2 Kolom Interaktif: Perbandingan Kehadiran per Jurusan & Feed 5 Tap Kartu Terbaru -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
        <!-- Kolom Kiri (7 Cols): Perbandingan Kehadiran per Jurusan & Guru -->
        <div class="lg:col-span-7 p-5 rounded-3xl bg-white border border-slate-200/80 shadow-xs flex flex-col justify-between space-y-4">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
              <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                  <span class="material-symbols-outlined text-[18px]">bar_chart</span>
                </span>
                <div>
                  <h3 class="font-bold text-slate-900 text-sm">Kehadiran per Jurusan & Guru</h3>
                  <p class="text-[11px] text-slate-400">Rasio kehadiran aktif hari ini berdasarkan kompetensi keahlian.</p>
                </div>
              </div>
              <span class="text-[10px] font-bold text-slate-600 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded-full">Target 90%</span>
            </div>

            <!-- 3 Bar Jurusan -->
            <div class="space-y-3.5 pt-3">
              <!-- AKL -->
              <div class="space-y-1.5">
                <div class="flex items-center justify-between text-xs">
                  <span class="font-bold text-slate-700 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                    <span>Siswa AKL (Akuntansi)</span>
                  </span>
                  <div class="flex items-center gap-2">
                    <span id="jurusan-akl-ratio" class="text-slate-400 text-[11px]">0/0 Siswa</span>
                    <span id="jurusan-akl-pct" class="font-black text-blue-700 text-xs">0%</span>
                  </div>
                </div>
                <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden">
                  <div id="jurusan-akl-bar" class="h-full bg-gradient-to-r from-blue-500 to-indigo-600 rounded-full transition-all duration-500 w-0"></div>
                </div>
              </div>

              <!-- RPL -->
              <div class="space-y-1.5">
                <div class="flex items-center justify-between text-xs">
                  <span class="font-bold text-slate-700 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
                    <span>Siswa RPL (Software)</span>
                  </span>
                  <div class="flex items-center gap-2">
                    <span id="jurusan-rpl-ratio" class="text-slate-400 text-[11px]">0/0 Siswa</span>
                    <span id="jurusan-rpl-pct" class="font-black text-indigo-700 text-xs">0%</span>
                  </div>
                </div>
                <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden">
                  <div id="jurusan-rpl-bar" class="h-full bg-gradient-to-r from-indigo-500 to-purple-600 rounded-full transition-all duration-500 w-0"></div>
                </div>
              </div>

              <!-- Guru -->
              <div class="space-y-1.5">
                <div class="flex items-center justify-between text-xs">
                  <span class="font-bold text-slate-700 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                    <span>Dewan Guru & Staf</span>
                  </span>
                  <div class="flex items-center gap-2">
                    <span id="jurusan-guru-ratio" class="text-slate-400 text-[11px]">0/0 Guru</span>
                    <span id="jurusan-guru-pct" class="font-black text-amber-700 text-xs">0%</span>
                  </div>
                </div>
                <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden">
                  <div id="jurusan-guru-bar" class="h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded-full transition-all duration-500 w-0"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
            <span>Standar Kurikulum Merdeka & BOSP</span>
            <span id="jurusan-top-badge" class="font-semibold text-slate-600">-</span>
          </div>
        </div>

        <!-- Kolom Kanan (5 Cols): Feed 5 Tap Kartu RFID Terbaru -->
        <div class="lg:col-span-5 p-5 rounded-3xl bg-white border border-slate-200/80 shadow-xs flex flex-col justify-between space-y-3">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
              <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                  <span class="material-symbols-outlined text-[18px]">sensors</span>
                </span>
                <div>
                  <h3 class="font-bold text-slate-900 text-sm">Aktivitas Gerbang Terbaru</h3>
                  <p class="text-[11px] text-slate-400">5 tap kartu RFID terakhir hari ini.</p>
                </div>
              </div>
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
            </div>

            <!-- List Taps Dinamis -->
            <div id="rekap-recent-taps" class="space-y-2 pt-2">
              <div class="py-6 text-center text-slate-400 text-xs font-medium">
                Belum ada tap kartu RFID hari ini.
              </div>
            </div>
          </div>

          <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-400 text-[11px]">Gerbang IoT Aktif</span>
            <button
              type="button"
              onclick="document.querySelector('[data-target=\'sec-riwayat\']')?.click()"
              class="font-bold text-blue-600 hover:text-blue-700 hover:underline flex items-center gap-0.5 text-[11px] cursor-pointer"
            >
              <span>Semua Log</span>
              <span class="material-symbols-outlined text-xs">arrow_forward</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================
         SECTION 2: DOKUMEN & CETAK PDF (DUAL-COLUMN BERISI & MINIMALIS)
         ======================================================== -->
    <section id="sec-dokumen" class="rekap-section space-y-5 hidden">
      <!-- Grid 2 Kolom: Kiri Katalog Dokumen (7 cols), Kanan Validasi Pengesahan (5 cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        
        <!-- KOLOM KIRI (7 Kolom): Berita Acara & Dokumen Siap Diterbitkan -->
        <div class="lg:col-span-7 space-y-4">
          
          <!-- Card Generator Dokumen Berjenjang -->
          <div class="p-6 rounded-3xl bg-white border border-slate-200/90 shadow-xs space-y-5">
            <!-- Header Form -->
            <div class="flex items-center justify-between pb-3.5 border-b border-slate-100">
              <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center shadow-md shadow-blue-500/20">
                  <span class="material-symbols-outlined text-xl">tune</span>
                </div>
                <div>
                  <h2 class="text-sm font-black text-slate-900">Generator Rekap & Download PDF</h2>
                  <p class="text-[11px] text-slate-500">Pilih kriteria berjenjang untuk menyusun dokumen resmi dinas.</p>
                </div>
              </div>
              <span class="px-2.5 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-[10px] font-bold">
                Step-by-Step
              </span>
            </div>

            <!-- STEP 1: PILIH JURUSAN / KATEGORI -->
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <label class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
                  <span class="w-5 h-5 rounded-full bg-blue-600 text-white text-[10px] font-black flex items-center justify-center">1</span>
                  <span>Pilih Jurusan / Kategori</span>
                </label>
                <span id="gen-jurusan-badge" class="text-[10px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded-md">Semua Jurusan</span>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                <button type="button" class="gen-dept-btn px-3 py-2.5 rounded-2xl border-2 border-blue-600 bg-blue-50/70 text-blue-900 font-bold text-xs flex flex-col items-center gap-1 transition-all active:scale-95 cursor-pointer text-center" data-dept="all">
                  <span class="material-symbols-outlined text-lg text-blue-600">domain</span>
                  <span>Semua</span>
                </button>
                <button type="button" class="gen-dept-btn px-3 py-2.5 rounded-2xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs flex flex-col items-center gap-1 transition-all active:scale-95 cursor-pointer text-center" data-dept="akl">
                  <span class="material-symbols-outlined text-lg text-emerald-600">account_balance</span>
                  <span>AKL</span>
                </button>
                <button type="button" class="gen-dept-btn px-3 py-2.5 rounded-2xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs flex flex-col items-center gap-1 transition-all active:scale-95 cursor-pointer text-center" data-dept="rpl">
                  <span class="material-symbols-outlined text-lg text-indigo-600">terminal</span>
                  <span>RPL</span>
                </button>
