            class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs flex items-center gap-1.5 shadow-md shadow-rose-500/25 transition active:scale-95 cursor-pointer hidden"
          >
            <span class="material-symbols-outlined text-sm">gavel</span>
            <span>Tindak Lanjut & Potong Poin</span>
          </button>
        </div>
      </div>
    </div>
  </div>

