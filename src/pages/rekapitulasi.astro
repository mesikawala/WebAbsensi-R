  <!-- Standalone High-Performance Vector PDF Libraries (Zero Vite optimize-dep friction) -->
  <script is:inline src="/assets/jspdf.umd.min.js"></script>
  <script is:inline src="/assets/jspdf.plugin.autotable.min.js"></script>

  <!-- ========================================================
       4. CLIENT SCRIPT (TAB SWITCHING & DATA BINDING)
       ======================================================== -->
  <script>
    let cachedLogs: any[] = [];
    let cachedStudents: any[] = [];
    let cachedPermits: any[] = [];
    let cachedDeductions: any[] = [];
    let currentFilter: 'today' | 'week' | 'month' | 'all' = 'today';
    let selectedClass: string = 'all';
    let searchQuery: string = '';

    const filterTitles: Record<string, string> = {
      today: 'Riwayat Presensi Hari Ini (Realtime Turso Cloud)',
      week: 'Arsip Presensi 7 Hari Terakhir (Turso Cloud)',
      month: 'Arsip Presensi 30 Hari Terakhir (Turso Cloud)',
      all: 'Seluruh Riwayat & Arsip Presensi (Turso Cloud)',
    };

    // Sub-nav Tab Switcher untuk Sidebar Khusus Rekap
    function setupRekapSubnav() {
      const navBtns = document.querySelectorAll('.rekap-nav-btn');
      const sections = document.querySelectorAll('.rekap-section');
      const titleEl = document.getElementById('rekap-current-tab-title');
      const descEl = document.getElementById('rekap-current-tab-desc');

      function switchTab(targetId: string) {
        navBtns.forEach((btn) => {
          const b = btn as HTMLElement;
          const isTarget = b.dataset.target === targetId;
          const chev = b.querySelector('.material-symbols-outlined:last-child') as HTMLElement | null;

          if (isTarget) {
            b.classList.add('bg-white', 'text-blue-900', 'font-bold', 'shadow-lg', 'shadow-blue-950/25', 'border-l-4', 'border-indigo-700', 'translate-x-1');
            b.classList.remove('text-blue-100/80', 'hover:text-white', 'hover:bg-white/15', 'hover:translate-x-0.5');
            if (chev) chev.style.opacity = '1';

            if (titleEl && b.dataset.title) titleEl.textContent = b.dataset.title;
            if (descEl && b.dataset.desc) descEl.textContent = b.dataset.desc;
          } else {
            b.classList.remove('bg-white', 'text-blue-900', 'font-bold', 'shadow-lg', 'shadow-blue-950/25', 'border-l-4', 'border-indigo-700', 'translate-x-1');
            b.classList.add('text-blue-100/80', 'hover:text-white', 'hover:bg-white/15', 'hover:translate-x-0.5');
            if (chev) chev.style.opacity = '0.6';
          }
        });

        sections.forEach((sec) => {
          if (sec.id === targetId) {
            sec.classList.remove('hidden');
          } else {
            sec.classList.add('hidden');
          }
        });
      }

      navBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = (btn as HTMLElement).dataset.target;
          if (targetId) switchTab(targetId);
        });
      });
    }

    let studentByRfid: Record<string, any> = {};
    let studentByName: Record<string, any> = {};

    function getStudentPoints(rfidUid?: string, studentId?: string, role?: string): number {
      if (role === 'guru' || role === 'admin') return 100;
      let totalDed = 0;
      const cleanRfid = (rfidUid || '').trim().toUpperCase();
      const cleanSid = (studentId || '').trim().toUpperCase();

      if (Array.isArray(cachedDeductions)) {
        cachedDeductions.forEach((d: any) => {
          const dRfid = (d.rfidUid || '').trim().toUpperCase();
          const dSid = (d.studentId || '').trim().toUpperCase();
          if ((cleanRfid && dRfid === cleanRfid) || (cleanSid && dSid === cleanSid)) {
            totalDed += Number(d.pointsDeducted) || 0;
          }
        });
      }
      return Math.max(0, 100 - totalDed);
    }

    function getFilteredLogs(): any[] {
      let logs = cachedLogs;
      if (selectedClass !== 'all') {
        if (selectedClass === 'guru') {
          logs = logs.filter((l: any) => 
            l.role === 'guru' || 
            (l.className && (l.className.toLowerCase().includes('guru') || l.className.toLowerCase().includes('kepala')))
          );
        } else {
          logs = logs.filter((l: any) => l.className === selectedClass);
        }
      }
      if (searchQuery.trim()) {
        const q = searchQuery.toLowerCase().trim();
        logs = logs.filter((l: any) => {
          const name = (l.name || '').toLowerCase();
          const rfid = (l.rfidUid || '').toLowerCase();
          const cls = (l.className || '').toLowerCase();
          const st = (l.rfidUid && studentByRfid[l.rfidUid.trim().toUpperCase()]) || (l.name && studentByName[l.name.trim().toLowerCase()]);
          const ident = (st?.identifier || '').toLowerCase();
          return name.includes(q) || rfid.includes(q) || cls.includes(q) || ident.includes(q);
        });
      }
      return logs;
    }

    async function updateRekapStats() {
      try {
        const [sRes, pRes, ptRes, lRes] = await Promise.all([
          fetch('/api/students'),
          fetch('/api/permissions'),
          fetch('/api/points'),
          fetch('/api/attendance'),
        ]);
        cachedStudents = await sRes.json().catch(() => []);
        cachedPermits = await pRes.json().catch(() => []);
        cachedDeductions = await ptRes.json().catch(() => []);
        const todayLogs = await lRes.json().catch(() => []);

        // Bangun kamus student berdasarkan RFID dan Nama untuk lookup cepat & filter NISN
        studentByRfid = {};
        studentByName = {};
        cachedStudents.forEach((s: any) => {
          if (s.rfidUid) studentByRfid[s.rfidUid.trim().toUpperCase()] = s;
          if (s.name) studentByName[s.name.trim().toLowerCase()] = s;
        });

        // Fetch logs according to active filter for Riwayat & Dokumen
        if (currentFilter === 'today') {
          cachedLogs = todayLogs;
        } else {
          const aRes = await fetch(`/api/attendance/archive?filter=${currentFilter}`);
          cachedLogs = await aRes.json().catch(() => []);
        }

        const displayLogs = getFilteredLogs();

        // Tanggal Hari Ini Standar WIB (Asia/Jakarta)
        const todayStr = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });
        const approvedPermits = cachedPermits.filter(
          (p: any) => p.status === 'Disetujui' && p.startDate <= todayStr && (p.endDate || p.startDate) >= todayStr
        );
        const permitStudentIds = new Set(approvedPermits.map((p: any) => p.studentId));

        // 1. Perhitungan Statistik Menu 1 (Presensi Hari Ini Lengkap & Akurat)
        const bolosLogs = todayLogs.filter((l: any) => l.status === 'Bolos');
        const bolosUids = new Set(bolosLogs.map((l: any) => (l.rfidUid || '').trim().toUpperCase()));

        // Siswa Hadir & Terlambat (tidak double-count dengan yang bolos)
        const siswaMasuk = todayLogs.filter((l: any) => l.role !== 'guru' && l.type === 'masuk');
        const siswaHadirTepat = siswaMasuk.filter((l: any) => l.status === 'Hadir' && !bolosUids.has((l.rfidUid || '').trim().toUpperCase())).length;
        const siswaTerlambat = siswaMasuk.filter((l: any) => l.status === 'Terlambat' && !bolosUids.has((l.rfidUid || '').trim().toUpperCase())).length;

        // Guru Hadir (guru tap 1x sehari di sesi masuk atau siang)
        const guruLogs = todayLogs.filter((l: any) => l.role === 'guru');
        const guruHadirUids = new Set(guruLogs.map((l: any) => (l.rfidUid || '').trim().toUpperCase()));
        const guruHadirCount = guruHadirUids.size;

        const hadir = siswaHadirTepat + guruHadirCount;
        const terlambat = siswaTerlambat;
        const bolos = bolosLogs.length;
        const izin = approvedPermits.length;
        const pulang = todayLogs.filter((l: any) => l.type === 'pulang' && l.status === 'Pulang').length;

        // Seluruh civitas yang sudah tap hari ini (masuk, hadir, telat, pulang, bolos)
        const absenUids = new Set(todayLogs.map((l: any) => (l.rfidUid || '').trim().toUpperCase()));

        // Belum Absen: civitas (siswa & guru) yang belum tap sama sekali dan tidak sedang izin
        const belum = cachedStudents.filter((s: any) => {
          if (s.role === 'admin') return false;
          const uid = (s.rfidUid || '').trim().toUpperCase();
          return !absenUids.has(uid) && !permitStudentIds.has(s.id);
        }).length;

        const el = (id: string) => document.getElementById(id);
        const set = (id: string, v: string) => { const e = el(id); if (e) e.textContent = v; };

        // Bind 6 Kartu Metrik Menu 1
        set('rekap-hadir', String(hadir));
        set('rekap-terlambat', String(terlambat));
        set('rekap-bolos', String(bolos));
        set('rekap-izin', String(izin));
        set('rekap-pulang', String(pulang));
        set('rekap-belum', String(belum));
        set('rekap-stat-total-badge', `${todayLogs.length} Data Tercatat`);

        // Bind Metrik di Menu 3 (Riwayat Log)
        set('rekap-log-count', `${displayLogs.length} Data`);
        set('log-stat-count', `${displayLogs.length} Data`);
        set('log-stat-hadir', `${hadir} Civitas`);
        set('rekap-log-footer-text', `Menampilkan ${displayLogs.length} data presensi (${filterTitles[currentFilter] || currentFilter})`);

        // Update 3 Bar Kehadiran per Jurusan & Guru Hari Ini
        const aklTotal = cachedStudents.filter((s: any) => s.role !== 'guru' && s.className && s.className.includes('AKL'));
        const aklHadir = aklTotal.filter((s: any) => absenUids.has((s.rfidUid || '').trim().toUpperCase()));
        const aklPct = aklTotal.length ? Math.round((aklHadir.length / aklTotal.length) * 100) : 0;
        set('jurusan-akl-ratio', `${aklHadir.length}/${aklTotal.length} Siswa`);
        set('jurusan-akl-pct', `${aklPct}%`);
        const aklBar = el('jurusan-akl-bar');
        if (aklBar) aklBar.style.width = `${aklPct}%`;

        const rplTotal = cachedStudents.filter((s: any) => s.role !== 'guru' && s.className && s.className.includes('RPL'));
        const rplHadir = rplTotal.filter((s: any) => absenUids.has((s.rfidUid || '').trim().toUpperCase()));
        const rplPct = rplTotal.length ? Math.round((rplHadir.length / rplTotal.length) * 100) : 0;
        set('jurusan-rpl-ratio', `${rplHadir.length}/${rplTotal.length} Siswa`);
        set('jurusan-rpl-pct', `${rplPct}%`);
        const rplBar = el('jurusan-rpl-bar');
        if (rplBar) rplBar.style.width = `${rplPct}%`;

        const guruTotal = cachedStudents.filter((s: any) => s.role === 'guru');
        const guruHadir = guruTotal.filter((s: any) => absenUids.has((s.rfidUid || '').trim().toUpperCase()));
        const guruPct = guruTotal.length ? Math.round((guruHadir.length / guruTotal.length) * 100) : 0;
        set('jurusan-guru-ratio', `${guruHadir.length}/${guruTotal.length} Guru`);
        set('jurusan-guru-pct', `${guruPct}%`);
        const guruBar = el('jurusan-guru-bar');
        if (guruBar) guruBar.style.width = `${guruPct}%`;

        let bestJurusan = 'Belum Ada Kehadiran';
        if (aklPct > 0 || rplPct > 0 || guruPct > 0) {
          if (aklPct >= rplPct && aklPct >= guruPct) bestJurusan = '🏆 AKL Terdepan (' + aklPct + '%)';
          else if (rplPct >= aklPct && rplPct >= guruPct) bestJurusan = '🏆 RPL Terdepan (' + rplPct + '%)';
          else bestJurusan = '🏆 Dewan Guru Terdepan (' + guruPct + '%)';
        }
        set('jurusan-top-badge', bestJurusan);

        // Update Feed 5 Tap Kartu Terbaru (Langsung Ambil 5 Tap Paling Baru)
        const recentTapsEl = el('rekap-recent-taps');
        if (recentTapsEl) {
          const recentLogs = todayLogs.slice(0, 5);
          if (!recentLogs.length) {
            recentTapsEl.innerHTML = '<div class="py-6 text-center text-slate-400 text-xs font-medium">Belum ada tap kartu RFID hari ini.</div>';
          } else {
            recentTapsEl.innerHTML = recentLogs.map((t: any) => {
              const isMasuk = t.type === 'masuk';
              const badgeColor = t.status === 'Bolos' ? 'bg-rose-100 text-rose-800'
                : t.status === 'Terlambat' ? 'bg-amber-100 text-amber-800'
                : t.status === 'Pulang' ? 'bg-blue-100 text-blue-800'
                : 'bg-emerald-100 text-emerald-800';
              return `
                <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50/80 hover:bg-slate-100/80 border border-slate-100 transition">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-7 h-7 rounded-lg ${isMasuk ? 'bg-blue-100 text-blue-700' : 'bg-cyan-100 text-cyan-700'} flex items-center justify-center font-bold text-xs shrink-0">
                      ${(t.name || '?')[0].toUpperCase()}
                    </div>
                    <div class="min-w-0">
                      <p class="font-bold text-slate-800 text-xs truncate leading-tight">${t.name}</p>
                      <p class="text-[10px] text-slate-400 truncate">${t.className} • ${t.time} WIB</p>
                    </div>
                  </div>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${badgeColor} shrink-0">
                    ${t.status}
                  </span>
                </div>
              `;
            }).join('');
          }
        }


        // Filter Izin berdasarkan rombel aktif
        const filteredPermits = selectedClass === 'all'
          ? approvedPermits
          : (selectedClass === 'guru' ? [] : approvedPermits.filter((p: any) => p.className === selectedClass));

        // Update Print Header & Stat
        const targetLabel = selectedClass === 'all'
          ? 'SASARAN: SEMUA ROMBEL & DEWAN GURU'
          : (selectedClass === 'guru' ? 'SASARAN: DEWAN GURU & STAF' : `SASARAN: ROMBEL KELAS ${selectedClass.toUpperCase()}`);
        set('print-doc-target', targetLabel);
        set('print-stat-hadir', String(hadir));
        set('print-stat-terlambat', String(terlambat));
        set('print-stat-bolos', String(bolos));
        set('print-stat-izin', String(filteredPermits.length));
        set('print-stat-pulang', String(pulang));
        set('print-stat-belum', String(belum));

        // Ambil Data Pejabat Pengesah Dinamis dari Database Civitas
        const kepsekCivitas = cachedStudents.find((s: any) => 
          s.tag === 'kepsek' || 
          (s.className && s.className.toLowerCase().includes('kepala sekolah')) ||
          (s.name && s.name.toLowerCase().includes('ahmad fauzi'))
        );
        const wakaCivitas = cachedStudents.find((s: any) => 
          s.tag === 'waka' || 
          (s.className && (s.className.toLowerCase().includes('kesiswaan') || s.className.toLowerCase().includes('waka'))) ||
          (s.name && s.name.toLowerCase().includes('wahyu hidayat'))
        );

        const kepsekName = kepsekCivitas?.name || 'H. Ahmad Fauzi, S.Pd., M.M.';
        const kepsekNipRaw = kepsekCivitas?.identifier || '197805122005011008';
        const kepsekNip = kepsekNipRaw.startsWith('NIP') ? kepsekNipRaw : `NIP. ${kepsekNipRaw}`;

        const wakaName = wakaCivitas?.name || 'Wahyu Hidayat, M.Kom';
        const wakaNipRaw = wakaCivitas?.identifier || '198403152009021003';
        const wakaNip = wakaNipRaw.startsWith('NIP') ? wakaNipRaw : `NIP. ${wakaNipRaw}`;

        // Pasang ke Layar Pratinjau Pejabat Menu 2
        set('screen-kepsek-name', kepsekName);
        set('screen-kepsek-nip', `Kepala Sekolah • ${kepsekNip}`);
        set('screen-waka-name', wakaName);
        set('screen-waka-nip', `Waka Kesiswaan • ${wakaNip}`);

        // Pasang ke Lembar Cetak Dokumen Resmi
        set('print-kepsek-name', kepsekName);
        set('print-kepsek-nip', kepsekNip);
        set('print-waka-name', wakaName);
        set('print-waka-nip', wakaNip);

        const tbody = el('rekap-log-body');
        if (!tbody) return;
        if (!displayLogs.length) {
          tbody.innerHTML = `
            <tr>
              <td colspan="6" class="py-14 text-center">
                <div class="max-w-xs mx-auto flex flex-col items-center justify-center space-y-2">
                  <div class="w-12 h-12 rounded-2xl bg-slate-100 border border-slate-200/80 flex items-center justify-center text-slate-400 mb-1">
                    <span class="material-symbols-outlined text-2xl">history_toggle_off</span>
                  </div>
                  <p class="text-sm font-bold text-slate-800">Belum Ada Riwayat</p>
                  <p class="text-xs text-slate-400 leading-relaxed">Belum ada catatan presensi pada filter ini. Lakukan tap kartu atau coba simulator IoT.</p>
                  <div class="flex items-center gap-2 mt-2">
                    <button type="button" onclick="document.querySelector('[data-target=\'sec-otomatisasi\']')?.click()" class="px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 font-bold text-xs border border-blue-200 inline-flex items-center gap-1.5 transition active:scale-95 cursor-pointer">
                      <span class="material-symbols-outlined text-sm">tune</span>
                      <span>Pusat Otomatisasi</span>
                    </button>
                    <a href="/" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs border border-slate-200 inline-flex items-center gap-1.5 transition">
                      <span class="material-symbols-outlined text-sm">contactless</span>
                      <span>Beranda Tap</span>
                    </a>
                  </div>
                </div>
              </td>
            </tr>
          `;
          return;
        }

        tbody.innerHTML = displayLogs.map((l: any) => {
          const st = (l.rfidUid && studentByRfid[l.rfidUid.trim().toUpperCase()]) || (l.name && studentByName[l.name.trim().toLowerCase()]);
          const nisn = st?.identifier || (l.role === 'guru' ? 'NIP Guru' : 'NISN. -');
          const pts = getStudentPoints(l.rfidUid, st?.id, l.role);

          const bc = l.status === 'Bolos' ? 'bg-rose-100 text-rose-900 border-rose-300'
            : l.status === 'Terlambat' ? 'bg-amber-100 text-amber-900 border-amber-300'
            : l.status === 'Pulang' ? 'bg-blue-100 text-blue-800 border-blue-300'
            : 'bg-emerald-100 text-emerald-900 border-emerald-300';
          const badgeText = l.status === 'Bolos' ? 'Bolos (-10P)' : l.status;

          let pointBadge = `<span class="inline-flex items-center gap-1 font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/80 px-2 py-0.5 rounded-md text-[11px]">${pts} Poin</span>`;
          if (l.role === 'guru') {
            pointBadge = `<span class="text-slate-500 font-semibold text-[11px]">Pendidik</span>`;
          } else if (pts === 0) {
            pointBadge = `<span class="inline-flex items-center gap-1 font-bold text-rose-800 bg-rose-50 border border-rose-200 px-2 py-0.5 rounded-md text-[11px]">🚫 0 Poin</span>`;
          } else if (pts < 10) {
            pointBadge = `<span class="inline-flex items-center gap-1 font-bold text-amber-800 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-md text-[11px]">⚠️ ${pts} Poin</span>`;
          }

          const isGuru = l.role === 'guru';
          const avatarColor = isGuru ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-700';

          return `<tr class="odd:bg-white even:bg-slate-50/70 hover:bg-blue-50/60 transition-colors">
            <td class="py-3 px-5">
              <div class="flex items-center gap-2.5">
                <div class="w-7 h-7 rounded-lg ${avatarColor} flex items-center justify-center font-bold text-xs shrink-0">
                  ${(l.name || '?')[0].toUpperCase()}
                </div>
                <div class="min-w-0">
                  <p class="font-bold text-slate-900 text-xs truncate">${l.name}</p>
                  <p class="font-mono text-[10px] text-slate-400">${nisn}</p>
                </div>
              </div>
            </td>
            <td class="py-3 px-4">
              <span class="px-2 py-0.5 rounded-md bg-slate-100 border border-slate-200 text-slate-700 text-[11px] font-bold">${l.className}</span>
            </td>
            <td class="py-3 px-4 font-mono text-slate-500 text-xs">${l.date}</td>
            <td class="py-3 px-4">
              <span class="capitalize font-semibold text-slate-800 text-xs">${l.type}</span>
              <span class="text-slate-400 text-[11px] font-mono">(${l.time})</span>
            </td>
            <td class="py-3 px-4">
              <span class="inline-flex items-center gap-1 text-[11px] font-bold ${bc} border px-2.5 py-0.5 rounded-full">${badgeText}</span>
            </td>
            <td class="py-3 px-4">${pointBadge}</td>
          </tr>`;
        }).join('');
      } catch (e) { console.error(e); }
    }

    // 1. Ekspor CSV / Excel Terfilter
    function downloadExcelCSV() {
      const logs = getFilteredLogs();
      if (!logs || !logs.length) {
        alert('Belum ada data presensi pada rombel/filter ini untuk diekspor.');
        return;
      }
      const today = new Date().toISOString().split('T')[0];
      const studentByRfid: Record<string, any> = {};
      const studentByName: Record<string, any> = {};
      cachedStudents.forEach((s: any) => {
        if (s.rfidUid) studentByRfid[s.rfidUid.trim().toUpperCase()] = s;
        if (s.name) studentByName[s.name.trim().toLowerCase()] = s;
      });

      let csv = 'No,NISN/NIP,Nama Civitas,Kelas / Rombel,Peran,Sisa Poin Disiplin,Tanggal,Sesi Presensi,Waktu Presensi,Status Kehadiran,Nomor RFID\r\n';
      logs.forEach((l, idx) => {
        const st = (l.rfidUid && studentByRfid[l.rfidUid.trim().toUpperCase()]) || (l.name && studentByName[l.name.trim().toLowerCase()]);
        const nisn = st?.identifier || (l.role === 'guru' ? 'NIP' : 'NISN');
        const pts = getStudentPoints(l.rfidUid, st?.id, l.role);
        csv += `"${idx + 1}","${nisn}","${l.name}","${l.className}","${l.role}","${l.role === 'guru' ? 'Pendidik' : pts + ' Poin'}","${l.date}","${l.type}","${l.time} WIB","${l.status}","${l.rfidUid}"\r\n`;
      });

      const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      const classSlug = selectedClass === 'all' ? 'Semua_Rombel' : selectedClass.replace(/\s+/g, '_');
      a.download = `Rekap_Presensi_SMK_Maarif_${classSlug}_${currentFilter}_${today}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    // === 2. GENERATOR DOKUMEN RESMI (STEP-BY-STEP & UNDUH PDF) ===
    let genDept: 'all' | 'akl' | 'rpl' | 'guru' = 'all';
    let genClass: string = 'all';
    let genTime: 'today' | 'week' | 'month' | 'all' = 'today';

    const classOptionsByDept: Record<string, { label: string; value: string }[]> = {
      all: [
        { label: 'Semua Kelas & Seluruh Civitas', value: 'all' },
        { label: 'X RPL', value: 'X RPL' },
        { label: 'XI RPL', value: 'XI RPL' },
        { label: 'XII RPL', value: 'XII RPL' },
        { label: 'X AKL', value: 'X AKL' },
        { label: 'XI AKL', value: 'XI AKL' },
        { label: 'XII AKL', value: 'XII AKL' },
        { label: 'Dewan Guru & Staf', value: 'guru' },
      ],
      rpl: [
        { label: 'Semua Kelas RPL (X, XI, XII)', value: 'all' },
        { label: 'X RPL', value: 'X RPL' },
        { label: 'XI RPL', value: 'XI RPL' },
        { label: 'XII RPL', value: 'XII RPL' },
      ],
      akl: [
        { label: 'Semua Kelas AKL (X, XI, XII)', value: 'all' },
        { label: 'X AKL', value: 'X AKL' },
        { label: 'XI AKL', value: 'XI AKL' },
        { label: 'XII AKL', value: 'XII AKL' },
      ],
      guru: [
        { label: 'Seluruh Dewan Guru & Staf Pengajar', value: 'guru' },
      ],
    };

    function updateGeneratorClasses() {
      const select = document.getElementById('gen-class-select') as HTMLSelectElement | null;
      if (!select) return;
      const opts = classOptionsByDept[genDept] || classOptionsByDept.all;
      select.innerHTML = opts.map((o) => `<option value="${o.value}">${o.label}</option>`).join('');
      genClass = select.value || 'all';
    }

    async function prepareOfficialDocument() {
      // 1. Ambil rekaman logs sesuai periode
      let activeLogs: any[] = [];
      if (genTime === 'today') {
        activeLogs = cachedLogs;
      } else {
        try {
          const res = await fetch(`/api/attendance/archive?filter=${genTime}`);
          activeLogs = await res.json().catch(() => []);
        } catch {
          activeLogs = cachedLogs;
        }
      }

      // 2. Filter berdasarkan Jurusan
      let filtered = [...activeLogs];
      if (genDept === 'rpl') {
        filtered = filtered.filter((l: any) => l.role !== 'guru' && l.className && l.className.includes('RPL'));
      } else if (genDept === 'akl') {
        filtered = filtered.filter((l: any) => l.role !== 'guru' && l.className && l.className.includes('AKL'));
      } else if (genDept === 'guru') {
        filtered = filtered.filter((l: any) => l.role === 'guru');
      }

      // 3. Filter berdasarkan Kelas
      if (genClass !== 'all') {
        if (genClass === 'guru') {
          filtered = filtered.filter((l: any) => l.role === 'guru');
        } else {
          filtered = filtered.filter((l: any) => l.className === genClass);
        }
      }

      // Lookup student cepat
      const studentByRfid: Record<string, any> = {};
      const studentByName: Record<string, any> = {};
      cachedStudents.forEach((s: any) => {
        if (s.rfidUid) studentByRfid[s.rfidUid.trim().toUpperCase()] = s;
        if (s.name) studentByName[s.name.trim().toLowerCase()] = s;
      });

      // 4. Sertakan surat izin sah jika filter hari ini
      if (genTime === 'today') {
        const todayStr = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });
        const todayPermits = cachedPermits.filter(
          (p: any) => p.status === 'Disetujui' && p.startDate <= todayStr && (p.endDate || p.startDate) >= todayStr
        );
        todayPermits.forEach((p: any) => {
          let matchDept = true;
          if (genDept === 'rpl') matchDept = p.className && p.className.includes('RPL');
          if (genDept === 'akl') matchDept = p.className && p.className.includes('AKL');
          if (genDept === 'guru') matchDept = false;

          let matchClass = true;
          if (genClass !== 'all' && genClass !== 'guru') matchClass = p.className === genClass;

          if (matchDept && matchClass) {
            const alreadyInLog = filtered.some((l: any) => l.name === p.name);
            if (!alreadyInLog) {
              filtered.push({
                id: p.id,
                name: p.name,
                className: p.className,
                role: 'siswa',
                type: 'izin',
                time: p.createdAt ? p.createdAt.split('T')[1]?.slice(0, 5) || '07:00' : '07:00',
                status: p.type || 'Izin',
                isPermit: true,
                reason: p.reason
              });
            }
          }
        });
      }

      // 5. Perhitungan Statistik Kehadiran
      const hadirCount = filtered.filter((l: any) => l.status === 'Hadir').length;
      const telatCount = filtered.filter((l: any) => l.status === 'Terlambat').length;
      const bolosCount = filtered.filter((l: any) => l.status === 'Bolos').length;
      const izinCount = filtered.filter((l: any) => l.status === 'Izin' || l.status === 'Sakit' || l.isPermit).length;
      const pulangCount = filtered.filter((l: any) => l.type === 'pulang').length;

      // Hitung civitas terdaftar untuk angka belum absen
      let targetCivitas = cachedStudents.filter((s: any) => s.role !== 'admin');
      if (genDept === 'rpl') targetCivitas = targetCivitas.filter((s: any) => s.role !== 'guru' && s.className && s.className.includes('RPL'));
      if (genDept === 'akl') targetCivitas = targetCivitas.filter((s: any) => s.role !== 'guru' && s.className && s.className.includes('AKL'));
      if (genDept === 'guru') targetCivitas = targetCivitas.filter((s: any) => s.role === 'guru');
      if (genClass !== 'all') {
        if (genClass === 'guru') targetCivitas = targetCivitas.filter((s: any) => s.role === 'guru');
        else targetCivitas = targetCivitas.filter((s: any) => s.className === genClass);
      }
      const loggedNames = new Set(filtered.map((l: any) => l.name));
      const belumCount = Math.max(0, targetCivitas.filter((s: any) => !loggedNames.has(s.name)).length);

      // Hitung Rekomendasi 1 (Poin Disiplin BK)
      let sempurnaCount = 0;
      let sp1Count = 0;
      let sp2Count = 0;
      targetCivitas.forEach((s: any) => {
        if (s.role === 'guru') return;
        const pts = getStudentPoints(s.rfidUid, s.id, s.role);
        if (pts >= 100) sempurnaCount++;
        else if (pts >= 75) sp1Count++;
        else sp2Count++;
      });

      // Update Angka Statistik Lembar Cetak
      const statHadir = document.getElementById('print-stat-hadir');
      const statTelat = document.getElementById('print-stat-terlambat');
      const statBolos = document.getElementById('print-stat-bolos');
      const statIzin = document.getElementById('print-stat-izin');
      const statPulang = document.getElementById('print-stat-pulang');
      const statBelum = document.getElementById('print-stat-belum');
      if (statHadir) statHadir.textContent = String(hadirCount);
      if (statTelat) statTelat.textContent = String(telatCount);
      if (statBolos) statBolos.textContent = String(bolosCount);
      if (statIzin) statIzin.textContent = String(izinCount);
      if (statPulang) statPulang.textContent = String(pulangCount);
      if (statBelum) statBelum.textContent = String(belumCount);

      // Update Rekomendasi 1: Mini-Ringkasan Disiplin BK
      const statDisiplinSempurna = document.getElementById('print-stat-disiplin-sempurna');
      const statDisiplinSp1 = document.getElementById('print-stat-disiplin-sp1');
      const statDisiplinSp2 = document.getElementById('print-stat-disiplin-sp2');
      if (statDisiplinSempurna) statDisiplinSempurna.textContent = `${sempurnaCount} Siswa`;
      if (statDisiplinSp1) statDisiplinSp1.textContent = `${sp1Count} Siswa`;
      if (statDisiplinSp2) statDisiplinSp2.textContent = `${sp2Count} Siswa`;

      // Header Dokumen Lembar Cetak
      const now = new Date();
      const options: Intl.DateTimeFormatOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      const dateStr = now.toLocaleDateString('id-ID', options);
      const docDateEl = document.getElementById('print-doc-date');
      const signDateEl = document.getElementById('print-sign-date');
      if (docDateEl) docDateEl.textContent = dateStr;
      if (signDateEl) signDateEl.textContent = now.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });

      const deptLabel = genDept === 'all' ? 'SEMUA JURUSAN' : (genDept === 'guru' ? 'DEWAN GURU' : `JURUSAN ${genDept.toUpperCase()}`);
      const classLabel = genClass === 'all' ? 'SEMUA KELAS' : genClass.toUpperCase();
      const timeLabel = genTime === 'today' ? 'HARI INI' : (genTime === 'week' ? '7 HARI TERAKHIR' : (genTime === 'month' ? 'BULAN INI' : 'SEMUA ARSIP'));

      const targetEl = document.getElementById('print-doc-target');
      if (targetEl) targetEl.textContent = `SASARAN: ${deptLabel} (${classLabel}) • PERIODE: ${timeLabel}`;

      const titleEl = document.getElementById('print-doc-title');
      if (titleEl) titleEl.textContent = `BERITA ACARA REKAPITULASI PRESENSI & KEDISIPLINAN SISWA`;

      const tableTitleEl = document.getElementById('print-table-title');
      if (tableTitleEl) tableTitleEl.textContent = `Rincian Presensi & Sisa Poin Disiplin (${filtered.length} Data):`;

      // Pejabat Pengesah Dinamis
      const kepsekCivitas = cachedStudents.find((s: any) => 
        s.tag === 'kepsek' || 
        (s.className && s.className.toLowerCase().includes('kepala sekolah')) ||
        (s.name && s.name.toLowerCase().includes('ahmad fauzi'))
      );
      const wakaCivitas = cachedStudents.find((s: any) => 
        s.tag === 'waka' || 
        (s.className && (s.className.toLowerCase().includes('kesiswaan') || s.className.toLowerCase().includes('waka'))) ||
        (s.name && s.name.toLowerCase().includes('wahyu hidayat'))
      );
      const kName = kepsekCivitas?.name || 'H. Ahmad Fauzi, S.Pd., M.M.';
      const kNip = kepsekCivitas?.identifier?.startsWith('NIP') ? kepsekCivitas.identifier : `NIP. ${kepsekCivitas?.identifier || '197805122005011008'}`;
      const wName = wakaCivitas?.name || 'Wahyu Hidayat, M.Kom';
      const wNip = wakaCivitas?.identifier?.startsWith('NIP') ? wakaCivitas.identifier : `NIP. ${wakaCivitas?.identifier || '198403152009021003'}`;

      const printKepsekName = document.getElementById('print-kepsek-name');
      const printKepsekNip = document.getElementById('print-kepsek-nip');
      const printWakaName = document.getElementById('print-waka-name');
      const printWakaNip = document.getElementById('print-waka-nip');
      if (printKepsekName) printKepsekName.textContent = kName;
      if (printKepsekNip) printKepsekNip.textContent = kNip;
      if (printWakaName) printWakaName.textContent = wName;
      if (printWakaNip) printWakaNip.textContent = wNip;

      // 6. Buat Baris Tabel dengan Kolom Poin Disiplin (Rekomendasi 1)
      let rowsHtml = '';
      if (!filtered.length) {
        rowsHtml = '<tr><td colspan="9" class="py-4 text-center italic text-slate-500">Tidak ada rekaman presensi pada filter kriteria ini.</td></tr>';
      } else {
        rowsHtml = filtered.map((l: any, idx: number) => {
          const st = (l.rfidUid && studentByRfid[l.rfidUid.trim().toUpperCase()]) || (l.name && studentByName[l.name.trim().toLowerCase()]);
          const nisn = st?.identifier || (l.role === 'guru' ? 'NIP Guru' : '-');
          const pts = getStudentPoints(l.rfidUid, st?.id, l.role);
          let ptsText = '';
          if (l.role === 'guru') {
            ptsText = 'Pendidik';
          } else if (pts >= 100) {
            ptsText = '100 Poin (Tertib)';
          } else if (pts >= 75) {
            ptsText = `${pts} Poin (SP-1)`;
          } else {
            ptsText = `${pts} Poin (SP-2)`;
          }

          return `
            <tr class="border-b border-black text-[11px]">
              <td class="py-1.5 px-1 text-center border-r border-black">${idx + 1}</td>
              <td class="py-1.5 px-2 font-mono text-center border-r border-black">${nisn}</td>
              <td class="py-1.5 px-3 font-bold border-r border-black">${l.name}</td>
              <td class="py-1.5 px-2 border-r border-black">${l.className || '-'}</td>
              <td class="py-1.5 px-2 text-center capitalize border-r border-black">${l.type || 'masuk'}</td>
              <td class="py-1.5 px-2 text-center font-mono border-r border-black">${l.time || '-'}</td>
              <td class="py-1.5 px-2 font-semibold border-r border-black">${l.status === 'Bolos' ? 'Bolos (-10P)' : (l.status || 'Hadir')}</td>
              <td class="py-1.5 px-2 font-mono text-center font-bold border-r border-black ${pts < 75 ? 'text-rose-700' : ''}">${ptsText}</td>
              <td class="py-1.5 px-2 text-center text-[10px] text-slate-600">${l.isPermit ? '✓ Surat Izin' : '✓ Sah Sistem'}</td>
            </tr>
          `;
        }).join('');
      }

      const printTbody = document.getElementById('print-table-body');
      if (printTbody) printTbody.innerHTML = rowsHtml;

      return { 
        filtered, 
        hadirCount, 
        telatCount, 
        bolosCount, 
        izinCount, 
        pulangCount, 
        belumCount,
        sempurnaCount,
        sp1Count,
        sp2Count,
        kName,
        kNip,
        wName,
        wNip,
        dateStr,
        deptLabel,
        classLabel,
        timeLabel
      };
    }

    // Unduh Langsung Berkas PDF Vektor Menggunakan jsPDF + autoTable (Cepat & Anti Macet)
    async function generateAndDownloadPDF() {
      const btn = document.getElementById('btn-gen-download-pdf') as HTMLButtonElement | null;
      const modalBtn = document.getElementById('modal-btn-download') as HTMLButtonElement | null;
      const origContent = btn ? btn.innerHTML : '';
      const origModalContent = modalBtn ? modalBtn.innerHTML : '';

      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">sync</span><span>Menyusun PDF...</span>';
      }
      if (modalBtn) {
        modalBtn.disabled = true;
        modalBtn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">sync</span><span>Menyusun PDF...</span>';
      }

      try {
        const jsPdfLib = (window as any).jspdf?.jsPDF || (window as any).jsPDF;
        if (!jsPdfLib) {
          alert('Pustaka pembuat PDF sedang dimuat, silakan coba sesaat lagi.');
          return;
        }

        const docData = await prepareOfficialDocument();
        const {
          filtered,
          hadirCount,
          telatCount,
          bolosCount,
          izinCount,
          sempurnaCount,
          sp1Count,
          sp2Count,
          kName,
          kNip,
          wName,
          wNip,
          dateStr,
          deptLabel,
          classLabel,
          timeLabel
        } = docData;

        const doc = new jsPdfLib({ orientation: 'portrait', unit: 'mm', format: 'a4' });

        const runAutoTable = (options: any) => {
          if (typeof (doc as any).autoTable === 'function') {
            (doc as any).autoTable(options);
          } else if (typeof (window as any).jspdf?.autoTable === 'function') {
            (window as any).jspdf.autoTable(doc, options);
          } else if (typeof (window as any).autoTable === 'function') {
            (window as any).autoTable(doc, options);
          }
        };

        // Kop Surat Resmi
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(9);
        doc.text("LEMBAGA PENDIDIKAN MA'ARIF NU LAMPUNG TENGAH", 105, 14, { align: 'center' });
        doc.setFontSize(14);
        doc.text("SMK MA'ARIF PADANG RATU", 105, 20, { align: 'center' });
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(8);
        doc.text('Status Terakreditasi | NSS: 322120205001 | NPSN: 10802050', 105, 25, { align: 'center' });
        doc.text('Alamat: Jl. Raya Padang Ratu No. 01, Kec. Padang Ratu, Kab. Lampung Tengah, Kode Pos 34176', 105, 29, { align: 'center' });
        doc.text('Website: smkmaarifpadangratu.sch.id | Email: smkmaarifpadangratu@gmail.com', 105, 33, { align: 'center' });
        doc.setLineWidth(0.8);
        doc.line(14, 36, 196, 36);
        doc.setLineWidth(0.2);
        doc.line(14, 37.2, 196, 37.2);

        // Judul & Parameter Filter
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(11);
        doc.text('BERITA ACARA REKAPITULASI PRESENSI & KEDISIPLINAN SISWA', 105, 44, { align: 'center' });
        doc.setFontSize(8.5);
        doc.text(`SASARAN: ${deptLabel} (${classLabel}) • PERIODE: ${timeLabel}`, 105, 49, { align: 'center' });
        doc.setFont('helvetica', 'normal');
        doc.text(`Nomor: 421.5/091/SMK-MR/2026 • Hari/Tanggal: ${dateStr}`, 105, 53, { align: 'center' });

        // Mini-Ringkasan Disiplin BK & Kehadiran Table
        runAutoTable({
          startY: 56,
          margin: { left: 14, right: 14 },
          theme: 'grid',
          styles: { fontSize: 7.5, cellPadding: 2, halign: 'center' },
          headStyles: { fillColor: [241, 245, 249], textColor: [15, 23, 42], fontStyle: 'bold' },
          head: [
            ['Hadir', 'Terlambat', 'Bolos/Alpha', 'Izin/Sakit', 'Tertib (100P)', 'SP-1 (75-99P)', 'SP-2 (<75P)']
          ],
          body: [
            [
              String(hadirCount),
              String(telatCount),
              String(bolosCount),
              String(izinCount),
              `${sempurnaCount} Siswa`,
              `${sp1Count} Siswa`,
              `${sp2Count} Siswa`
            ]
          ]
        });

        // Detail Table Title
        const tableStartY = (doc as any).lastAutoTable?.finalY ? (doc as any).lastAutoTable.finalY + 5 : 68;
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(8.5);
        doc.text(`Rincian Presensi & Sisa Poin Disiplin (${filtered.length} Data):`, 14, tableStartY);

        // Map Rows for Table
        const tableBody = filtered.length ? filtered.map((l: any, idx: number) => {
          const st = (l.rfidUid && studentByRfid[l.rfidUid.trim().toUpperCase()]) || (l.name && studentByName[l.name.trim().toLowerCase()]);
          const nisn = st?.identifier || (l.role === 'guru' ? 'NIP Guru' : '-');
          const pts = getStudentPoints(l.rfidUid, st?.id, l.role);
          let ptsText = '';
          if (l.role === 'guru') {
            ptsText = 'Pendidik';
          } else if (pts >= 100) {
            ptsText = '100 P (Tertib)';
          } else if (pts >= 75) {
            ptsText = `${pts} P (SP-1)`;
          } else {
            ptsText = `${pts} P (SP-2)`;
          }

          const statusText = l.status === 'Bolos' ? 'Bolos (-10P)' : (l.status || 'Hadir');
          const parafText = l.isPermit ? 'Surat Izin' : 'Sah Sistem';

          return [
            String(idx + 1),
            String(nisn),
            String(l.name || '-'),
            String(l.className || '-'),
            String(l.type || 'masuk'),
            String(l.time || '-'),
            statusText,
            ptsText,
            parafText
          ];
        }) : [
          ['-', '-', 'Tidak ada rekaman presensi pada filter kriteria ini.', '-', '-', '-', '-', '-', '-']
        ];

        runAutoTable({
          startY: tableStartY + 2,
          margin: { left: 14, right: 14 },
          theme: 'grid',
          styles: { fontSize: 7.5, cellPadding: 1.8 },
          headStyles: { fillColor: [30, 41, 59], textColor: [255, 255, 255], fontStyle: 'bold', halign: 'center' },
          columnStyles: {
            0: { cellWidth: 8, halign: 'center' },
            1: { cellWidth: 24, halign: 'center' },
            2: { cellWidth: 42 },
            3: { cellWidth: 20, halign: 'center' },
            4: { cellWidth: 15, halign: 'center' },
            5: { cellWidth: 16, halign: 'center' },
            6: { cellWidth: 19, halign: 'center' },
            7: { cellWidth: 24, halign: 'center' },
            8: { cellWidth: 14, halign: 'center' }
          },
          head: [
            ['No', 'NISN', 'Nama Siswa', 'Kelas', 'Sesi', 'Jam', 'Status', 'Sisa Poin', 'Paraf']
          ],
          body: tableBody
        });

        // Signatures
        let sigY = (doc as any).lastAutoTable?.finalY ? (doc as any).lastAutoTable.finalY + 10 : 220;
        if (sigY > 245) {
          doc.addPage();
          sigY = 25;
        }

        const now = new Date();
        const signDateStr = now.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(8.5);
        doc.text(`Padang Ratu, ${signDateStr}`, 140, sigY);
        doc.text('Mengetahui,', 20, sigY + 5);
        doc.text('Kepala SMK Ma\'arif Padang Ratu', 140, sigY + 5);
        doc.text('Waka Bidang Kesiswaan', 20, sigY + 9);

        doc.setFont('helvetica', 'bold');
        doc.text(wName, 20, sigY + 28);
        doc.setFont('helvetica', 'normal');
        doc.text(wNip, 20, sigY + 32);

        doc.setFont('helvetica', 'bold');
        doc.text(kName, 140, sigY + 28);
        doc.setFont('helvetica', 'normal');
        doc.text(kNip, 140, sigY + 32);

        // Simpan Berkas PDF Vektor
        const deptSlug = genDept.toUpperCase();
        const classSlug = genClass === 'all' ? 'Semua_Kelas' : genClass.replace(/\s+/g, '_');
        const timeSlug = genTime.toUpperCase();
        const todayStr = new Date().toISOString().split('T')[0];
        const filename = `Laporan_Presensi_SMK_Maarif_${deptSlug}_${classSlug}_${timeSlug}_${todayStr}.pdf`;

        doc.save(filename);

        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('File PDF resmi berhasil diunduh langsung!', 'success');
        }
      } catch (err: any) {
        console.error('PDF Generation Error:', err);
        alert('Gagal menyusun PDF: ' + (err?.message || err));
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = origContent;
        }
        if (modalBtn) {
          modalBtn.disabled = false;
          modalBtn.innerHTML = origModalContent;
        }
      }
    }

    // Buka Modal Pratinjau Dokumen A4 di Layar
    async function openDocumentPreviewModal() {
      await prepareOfficialDocument();
      const printEl = document.getElementById('print-area');
      const container = document.getElementById('modal-paper-container');
      const modal = document.getElementById('modal-print-preview');
      if (printEl && container && modal) {
        container.innerHTML = printEl.innerHTML;
        modal.classList.remove('hidden');
      }
    }

    function closeDocumentPreviewModal() {
      const modal = document.getElementById('modal-print-preview');
      if (modal) modal.classList.add('hidden');
    }

    // Salin Ringkasan Sesuai Filter Generator ke WhatsApp
    async function copyGeneratedWhatsApp() {
      const { filtered, hadirCount, telatCount, bolosCount, izinCount, pulangCount, belumCount } = await prepareOfficialDocument();
      const now = new Date();
      const dateStr = now.toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
      const deptLabel = genDept === 'all' ? 'Semua Jurusan (AKL & RPL)' : (genDept === 'guru' ? 'Dewan Guru' : `Jurusan ${genDept.toUpperCase()}`);
      const classLabel = genClass === 'all' ? 'Semua Kelas' : genClass;

      const text = `*LAPORAN PRESENSI & KEDISIPLINAN RESMI SMK MA'ARIF PADANG RATU*
🎯 Sasaran: *${deptLabel} (${classLabel})*
📅 Tanggal: ${dateStr}

📊 *Ringkasan Kehadiran:*
• Hadir Tepat Waktu : ${hadirCount} orang
• Terlambat         : ${telatCount} orang
• Bolos (-10 Poin)  : ${bolosCount} orang
• Izin / Dispensasi : ${izinCount} orang
• Sudah Pulang      : ${pulangCount} orang
• Belum Absen       : ${belumCount} orang

⭐ *Kedisiplinan & Poin:* Disertakan otomatis di berkas PDF resmi.
Total Log Presensi: ${filtered.length} data.
_Dokumen resmi sah sistem presensi terintegrasi SI-HADIR IoT._`;

      if (navigator && navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
        navigator.clipboard.writeText(text).then(() => {
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast('Ringkasan WA berhasil disalin ke clipboard!', 'success');
          } else {
            alert('Ringkasan laporan presensi berhasil disalin!');
          }
        }).catch(() => {
          prompt('Salin teks laporan berikut:', text);
        });
      } else {
        prompt('Salin teks laporan berikut:', text);
      }
    }

    // 3. Salin Ringkasan WhatsApp
    function copyWhatsAppSummary() {
      const now = new Date();
      const dateStr = now.toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

      const hadir = document.getElementById('rekap-hadir')?.textContent || '0';
      const terlambat = document.getElementById('rekap-terlambat')?.textContent || '0';
      const bolos = document.getElementById('rekap-bolos')?.textContent || '0';
      const izin = document.getElementById('rekap-izin')?.textContent || '0';
      const pulang = document.getElementById('rekap-pulang')?.textContent || '0';
      const belum = document.getElementById('rekap-belum')?.textContent || '0';

      const rombelLabel = selectedClass === 'all' ? 'Semua Rombel & Guru' : (selectedClass === 'guru' ? 'Dewan Guru & Staf' : selectedClass);

      const text = `*LAPORAN PRESENSI RESMI SMK MA'ARIF PADANG RATU*
🎯 Sasaran Rombel: *${rombelLabel}*
📅 Tanggal: ${dateStr}

📊 *Ringkasan Kehadiran:*
• Hadir Tepat Waktu : ${hadir} orang
• Terlambat         : ${terlambat} orang
• Bolos (-10 Poin)  : ${bolos} orang
• Izin / Dispensasi : ${izin} orang
• Sudah Pulang      : ${pulang} orang
• Belum Absen       : ${belum} orang

Total Log Presensi: ${getFilteredLogs().length} data (${filterTitles[currentFilter] || currentFilter}).
_Laporan otomatis terverifikasi sistem SI-HADIR IoT & Turso Cloud._`;

      if (navigator && navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
        navigator.clipboard.writeText(text).then(() => {
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast('Ringkasan WA berhasil disalin ke clipboard!', 'success');
          } else {
            alert('Ringkasan laporan presensi berhasil disalin! Anda bisa langsung menempelkannya (Paste) ke WhatsApp.');
          }
        }).catch(() => {
          prompt('Salin teks laporan berikut untuk WhatsApp:', text);
        });
      } else {
        prompt('Salin teks laporan berikut untuk WhatsApp:', text);
      }
    }

    // Listener Filter Search Realtime (Debounce 120ms untuk responsivitas optimal)
    let searchDebounceTimer: any = null;
    document.getElementById('filter-search')?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => {
        updateRekapStats();
      }, 120);
    });

    // Listener Filter Rombel
    document.getElementById('filter-rombel')?.addEventListener('change', (e) => {
      selectedClass = (e.target as HTMLSelectElement).value;
      updateRekapStats();
    });

    // Filter Buttons Switcher Periode
    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const filter = target.getAttribute('data-filter') as any;
        if (!filter) return;
        currentFilter = filter;

        // UI styling
        document.querySelectorAll('.filter-btn').forEach((b) => {
          b.classList.remove('active', 'bg-white', 'text-blue-700', 'shadow-xs', 'font-bold');
          b.classList.add('text-slate-600', 'font-medium');
        });
        target.classList.add('active', 'bg-white', 'text-blue-700', 'shadow-xs', 'font-bold');
        target.classList.remove('text-slate-600', 'font-medium');

        const titleEl = document.getElementById('rekap-table-title');
        if (titleEl) titleEl.textContent = filterTitles[filter] || 'Riwayat Presensi';

        updateRekapStats();
      });
    });

    // Pengukuran Latensi Cloud Riil
    async function measureLatency() {
      const t0 = performance.now();
      try {
        await fetch('/api/settings');
        const lat = Math.round(performance.now() - t0);
        const el = document.getElementById('cloud-latency-val');
        if (el) el.textContent = `${lat} ms (SG Cloud)`;
      } catch {
        const el = document.getElementById('cloud-latency-val');
        if (el) el.textContent = 'Aktif (SG)';
      }
    }

    // === LOGIKA STEP-BY-STEP TINDAK LANJUT SISWA BOLOS ===
    let bolosStep = 1;
    let selectedBolosDept = '';
    let selectedBolosClass = '';
    let selectedBolosStudent: any = null;

    function openBolosModal() {
      bolosStep = 1;
      selectedBolosDept = '';
      selectedBolosClass = '';
      selectedBolosStudent = null;
      renderBolosStep();
      const modal = document.getElementById('modal-tindak-bolos');
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }

    function closeBolosModal() {
      const modal = document.getElementById('modal-tindak-bolos');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    function renderBolosStep() {
      const line = document.getElementById('bolos-progress-line');
      if (line) line.style.width = `${((bolosStep - 1) / 3) * 100}%`;

      for (let s = 1; s <= 4; s++) {
        const badge = document.getElementById(`bolos-badge-${s}`);
        const label = document.getElementById(`bolos-label-${s}`);
        const panel = document.getElementById(`bolos-panel-${s}`);

        if (panel) {
          if (s === bolosStep) panel.classList.remove('hidden');
          else panel.classList.add('hidden');
        }

        if (badge && label) {
          if (s === bolosStep) {
            badge.className = 'w-7 h-7 rounded-full bg-rose-600 text-white font-black text-xs flex items-center justify-center shadow-md shadow-rose-500/30 transition-all';
            badge.textContent = String(s);
            label.className = 'text-[10px] font-bold text-rose-700 whitespace-nowrap';
          } else if (s < bolosStep) {
            badge.className = 'w-7 h-7 rounded-full bg-emerald-500 text-white font-black text-xs flex items-center justify-center transition-all';
            badge.textContent = '✓';
            label.className = 'text-[10px] font-semibold text-emerald-700 whitespace-nowrap';
          } else {
            badge.className = 'w-7 h-7 rounded-full bg-slate-100 text-slate-400 font-bold text-xs flex items-center justify-center transition-all';
            badge.textContent = String(s);
            label.className = 'text-[10px] font-semibold text-slate-400 whitespace-nowrap';
          }
        }
      }

      const backBtn = document.getElementById('btn-bolos-back');
      const submitBtn = document.getElementById('btn-bolos-submit');
      if (backBtn) {
        if (bolosStep > 1) backBtn.classList.remove('hidden');
        else backBtn.classList.add('hidden');
      }
      if (submitBtn) {
        if (bolosStep === 4) submitBtn.classList.remove('hidden');
        else submitBtn.classList.add('hidden');
      }
    }

    function populateBolosClasses() {
      const container = document.getElementById('bolos-class-list');
      if (!container) return;

      const deptLabel = selectedBolosDept === 'rpl' ? 'RPL' : 'AKL';
      const classes = [
        { label: `Semua Kelas ${deptLabel}`, value: 'all', desc: `Seluruh Siswa ${deptLabel}` },
        { label: `X ${deptLabel}`, value: `X ${deptLabel}`, desc: 'Kelas 10' },
        { label: `XI ${deptLabel}`, value: `XI ${deptLabel}`, desc: 'Kelas 11' },
        { label: `XII ${deptLabel}`, value: `XII ${deptLabel}`, desc: 'Kelas 12' },
      ];

      container.className = 'grid grid-cols-2 gap-2.5 pt-1';
      container.innerHTML = classes.map((c: any) => `
        <button type="button" class="bolos-class-pick-btn p-3.5 rounded-2xl border-2 border-slate-200 hover:border-rose-500 hover:bg-rose-50/50 bg-white transition-all active:scale-95 cursor-pointer text-left flex flex-col justify-between group" data-class="${c.value}">
          <span class="font-black text-slate-900 text-xs sm:text-sm group-hover:text-rose-600 transition-colors">${c.label}</span>
          <span class="text-[10px] text-slate-400 font-medium mt-0.5">${c.desc}</span>
        </button>
      `).join('');

      container.querySelectorAll('.bolos-class-pick-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          selectedBolosClass = (e.currentTarget as HTMLElement).dataset.class || 'all';
          bolosStep = 3;
          renderBolosStep();
          populateBolosStudents();
        });
      });
    }

    function populateBolosStudents(searchFilter: string = '') {
      const container = document.getElementById('bolos-student-list');
      const hint = document.getElementById('bolos-student-class-hint');
      const deptLabel = selectedBolosDept === 'rpl' ? 'RPL' : 'AKL';
      const classTitle = selectedBolosClass === 'all' ? `Semua Kelas ${deptLabel}` : `Kelas ${selectedBolosClass}`;
      if (hint) hint.textContent = `${classTitle} • Pilih siswa yang melakukan pelanggaran bolos`;
      if (!container) return;

      let students = cachedStudents.filter((s: any) => {
        if (s.role !== 'siswa') return false;
        const sCategory = (s.category || '').toLowerCase();
        const sClass = (s.className || '').toUpperCase();
        
        const matchDept = selectedBolosDept === 'rpl' 
          ? (sCategory === 'rpl' || sClass.includes('RPL'))
          : (sCategory === 'akl' || sClass.includes('AKL'));
        if (!matchDept) return false;

        if (selectedBolosClass && selectedBolosClass !== 'all') {
          const cleanClass = sClass.replace(/\s*[12]$/, '').trim();
          return cleanClass === selectedBolosClass.toUpperCase() || sClass === selectedBolosClass.toUpperCase();
        }

        return true;
      });

      if (searchFilter.trim()) {
        const q = searchFilter.toLowerCase().trim();
        students = students.filter((s: any) => 
          (s.name || '').toLowerCase().includes(q) || 
          (s.identifier || '').toLowerCase().includes(q) ||
          (s.className || '').toLowerCase().includes(q)
        );
      }

      if (!students.length) {
        container.innerHTML = '<p class="text-xs text-slate-400 italic text-center py-6">Tidak ada data siswa ditemukan.</p>';
        return;
      }

      container.innerHTML = students.map((s: any) => {
        const pts = getStudentPoints(s.rfidUid, s.id, s.role);
        return `
          <button type="button" class="bolos-student-pick-btn w-full p-2.5 rounded-xl border border-slate-100 hover:border-rose-400 hover:bg-rose-50/40 bg-slate-50/60 transition flex items-center justify-between text-left cursor-pointer active:scale-[0.99]" data-id="${s.id}">
            <div class="flex items-center gap-2.5 min-w-0">
              <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-800 font-bold text-xs flex items-center justify-center shrink-0">
                ${s.name.charAt(0)}
              </div>
              <div class="min-w-0">
                <p class="font-bold text-xs text-slate-900 truncate">${s.name}</p>
                <p class="text-[10px] text-slate-400 font-mono">${s.className} • NISN: ${s.identifier || '-'}</p>
              </div>
            </div>
            <div class="text-right shrink-0">
              <span class="text-xs font-black font-mono ${pts < 75 ? 'text-rose-600' : 'text-slate-800'}">${pts} P</span>
              <span class="block text-[9px] text-slate-400">Pilih →</span>
            </div>
          </button>
        `;
      }).join('');

      container.querySelectorAll('.bolos-student-pick-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const sid = (e.currentTarget as HTMLElement).dataset.id;
          selectedBolosStudent = cachedStudents.find((s: any) => s.id === sid);
          if (selectedBolosStudent) {
            bolosStep = 4;
            renderBolosStep();
            populateBolosConfirmation();
          }
        });
      });
    }

    function populateBolosConfirmation() {
      if (!selectedBolosStudent) return;
      const initial = document.getElementById('bolos-conf-initial');
      const name = document.getElementById('bolos-conf-name');
      const meta = document.getElementById('bolos-conf-meta');
      const currentPts = document.getElementById('bolos-conf-current-pts');

      const pts = getStudentPoints(selectedBolosStudent.rfidUid, selectedBolosStudent.id, selectedBolosStudent.role);

      if (initial) initial.textContent = selectedBolosStudent.name.charAt(0);
      if (name) name.textContent = selectedBolosStudent.name;
      if (meta) meta.textContent = `NISN: ${selectedBolosStudent.identifier || '-'} • Kelas: ${selectedBolosStudent.className || '-'}`;
      if (currentPts) currentPts.textContent = `${pts} Poin`;
    }

    async function submitSingleBolos() {
      if (!selectedBolosStudent) return;
      const btn = document.getElementById('btn-bolos-submit') as HTMLButtonElement | null;
      const origText = btn ? btn.innerHTML : '';
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">sync</span><span>Memproses...</span>';
      }

      try {
        const res = await fetch('/api/attendance/bolos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ studentId: selectedBolosStudent.id }),
        });
        const result = await res.json();
        alert(result.message || `Siswa ${selectedBolosStudent.name} berhasil ditindaklanjuti dan dipotong 10 poin!`);
        closeBolosModal();
        await updateRekapStats();
      } catch (err: any) {
        alert('Gagal mengeksekusi sanksi: ' + err.message);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = origText;
        }
      }
    }

    async function runBulkBolos() {
      const confirmRun = confirm(
        'Jalankan Evaluasi Deteksi Bolos untuk SELURUH SISWA hari ini?\n\n' +
        'Siswa yang masuk pagi tanpa tap pulang akan otomatis dikategorikan "Bolos" dan dipotong 10 Poin.'
      );
      if (!confirmRun) return;
      closeBolosModal();
      try {
        const res = await fetch('/api/attendance/bolos', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
        const result = await res.json();
        alert(result.message || 'Evaluasi bolos massal selesai!');
        await updateRekapStats();
      } catch (err: any) {
        alert('Gagal mengeksekusi evaluasi bolos: ' + err.message);
      }
    }

    // Event Listeners Modal Bolos
    document.getElementById('btn-eval-bolos')?.addEventListener('click', openBolosModal);
    document.getElementById('btn-close-bolos-modal')?.addEventListener('click', closeBolosModal);
    document.getElementById('btn-bolos-cancel')?.addEventListener('click', closeBolosModal);
    document.getElementById('btn-bolos-submit')?.addEventListener('click', submitSingleBolos);
    document.getElementById('btn-bolos-bulk-all')?.addEventListener('click', runBulkBolos);

    document.getElementById('btn-bolos-back')?.addEventListener('click', () => {
      if (bolosStep > 1) {
        bolosStep--;
        renderBolosStep();
      }
    });

    document.querySelectorAll('.bolos-step-indicator').forEach((ind) => {
      ind.addEventListener('click', () => {
        const target = parseInt((ind as HTMLElement).dataset.step || '1', 10);
        if (target === bolosStep) return;
        if (target > bolosStep) {
          if (target >= 2 && !selectedBolosDept) return;
          if (target >= 3 && !selectedBolosClass) return;
          if (target >= 4 && !selectedBolosStudent) return;
        }
        bolosStep = target;
        renderBolosStep();
        if (target === 2) populateBolosClasses();
        if (target === 3) populateBolosStudents();
        if (target === 4) populateBolosConfirmation();
      });
    });

    document.querySelectorAll('.bolos-dept-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        selectedBolosDept = (e.currentTarget as HTMLElement).dataset.dept || 'rpl';
        bolosStep = 2;
        renderBolosStep();
        populateBolosClasses();
      });
    });

    document.getElementById('bolos-student-search')?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      populateBolosStudents(val);
    });

    // Action 2: Arsip Jam 23:00 Riil
    document.getElementById('btn-trigger-archive')?.addEventListener('click', async () => {
      const confirmRun = confirm(
        'Simulasikan otomatisasi Jam 23:00 WIB?\n\n' +
        'Sistem akan:\n' +
        '1. Menghukum siswa bolos (-10 poin)\n' +
        '2. Memindahkan log hari ini ke tabel arsip historis (attendance_history)\n' +
        '3. Mengosongkan status aktif agar esok hari kembali bersih.'
      );
      if (!confirmRun) return;

      const btn = document.getElementById('btn-trigger-archive') as HTMLButtonElement;
      const origText = btn ? btn.innerHTML : '';
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">sync</span><span>Mengarsip...</span>';
      }

      try {
        const res = await fetch('/api/attendance/archive', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
        const result = await res.json();
        alert(result.message || 'Arsip harian berhasil diselesaikan!');
        await updateRekapStats();
      } catch (err: any) {
        alert('Gagal mengeksekusi arsip: ' + err.message);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = origText;
        }
      }
    });


    // === BINDING GENERATOR DOKUMEN & UNDUH PDF ===
    (window as any).generateAndDownloadPDF = generateAndDownloadPDF;
    (window as any).openDocumentPreviewModal = openDocumentPreviewModal;
    (window as any).closeDocumentPreviewModal = closeDocumentPreviewModal;
    (window as any).copyGeneratedWhatsApp = copyGeneratedWhatsApp;
    (window as any).downloadExcelCSV = downloadExcelCSV;

    // Step 1: Pilihan Jurusan
    document.querySelectorAll('.gen-dept-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const dept = target.getAttribute('data-dept') as any;
        if (!dept) return;
        genDept = dept;

        document.querySelectorAll('.gen-dept-btn').forEach((b) => {
          b.classList.remove('border-2', 'border-blue-600', 'bg-blue-50/70', 'text-blue-900');
          b.classList.add('border', 'border-slate-200', 'bg-white', 'text-slate-700');
        });
        target.classList.add('border-2', 'border-blue-600', 'bg-blue-50/70', 'text-blue-900');
        target.classList.remove('border', 'border-slate-200', 'bg-white', 'text-slate-700');

        const badge = document.getElementById('gen-jurusan-badge');
        if (badge) {
          const names: Record<string, string> = { all: 'Semua Jurusan', akl: 'Jurusan AKL', rpl: 'Jurusan RPL', guru: 'Dewan Guru' };
          badge.textContent = names[dept] || dept;
        }

        updateGeneratorClasses();
      });
    });

    // Step 2: Pilihan Kelas
    document.getElementById('gen-class-select')?.addEventListener('change', (e) => {
      genClass = (e.target as HTMLSelectElement).value;
    });

    // Step 3: Pilihan Waktu
    document.querySelectorAll('.gen-time-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const time = target.getAttribute('data-time') as any;
        if (!time) return;
        genTime = time;

        document.querySelectorAll('.gen-time-btn').forEach((b) => {
          b.classList.remove('border-2', 'border-indigo-600', 'bg-indigo-50/70', 'text-indigo-900');
          b.classList.add('border', 'border-slate-200', 'bg-white', 'text-slate-700');
        });
        target.classList.add('border-2', 'border-indigo-600', 'bg-indigo-50/70', 'text-indigo-900');
        target.classList.remove('border', 'border-slate-200', 'bg-white', 'text-slate-700');

        const badge = document.getElementById('gen-period-badge');
        if (badge) {
          const names: Record<string, string> = { today: 'Hari Ini', week: '1 Minggu', month: '1 Bulan', all: '1 Tahun / Arsip' };
          badge.textContent = names[time] || time;
        }
      });
    });

    // Action Generator Buttons
    document.getElementById('btn-gen-download-pdf')?.addEventListener('click', generateAndDownloadPDF);
    document.getElementById('btn-gen-preview')?.addEventListener('click', openDocumentPreviewModal);
    document.getElementById('btn-gen-copy-wa')?.addEventListener('click', copyGeneratedWhatsApp);

    // Modal Action Buttons
    document.getElementById('modal-btn-download')?.addEventListener('click', generateAndDownloadPDF);
    document.getElementById('modal-btn-close')?.addEventListener('click', closeDocumentPreviewModal);

    // Export & Action Listeners
    document.getElementById('btn-export-excel')?.addEventListener('click', downloadExcelCSV);
    document.getElementById('sidebar-btn-excel')?.addEventListener('click', downloadExcelCSV);
    document.getElementById('sidebar-btn-wa')?.addEventListener('click', copyGeneratedWhatsApp);

    // Inisialisasi Tab Switcher & Load Data
    setupRekapSubnav();
    window.addEventListener('attendance-updated', updateRekapStats);
    updateRekapStats();
    measureLatency();
  </script>
</Layout>
