    function openEditModal(student: any) {
      if (modalTitle) modalTitle.textContent = "Edit Data & Ganti Kartu RFID";
      if (idInput) idInput.value = student.id || "";
      if (nameInput) nameInput.value = student.name || "";
      if (identInput) identInput.value = student.identifier || "";
      if (addressInput)
        addressInput.value = student.address || "Padang Ratu, Lampung";
      if (birthInput) birthInput.value = student.birthDate || "";
      if (emailInput) emailInput.value = student.email || "";
      if (phoneInput) phoneInput.value = student.phone || "";
      const r = (
        student.role === "admin"
          ? "admin"
          : student.role === "guru"
            ? "guru"
            : "siswa"
      ) as "siswa" | "guru" | "admin";
      setRole(r);
      if (catSelect)
        catSelect.value =
          student.category ||
          (r === "admin" ? "admin" : r === "guru" ? "guru" : "rpl");
      if (classInput) classInput.value = student.className || "";
      if (uidInput) {
        if (r === "admin") {
          uidInput.value = "";
          uidInput.placeholder =
            "Terkunci di Database (Hanya bisa dicek via Turso)";
          uidInput.disabled = true;
        } else {
          uidInput.value = student.rfidUid || "";
          uidInput.placeholder = "Tempel kartu RFID atau klik Generate";
          uidInput.disabled = false;
        }
      }
      if (btnGenUid) btnGenUid.classList.toggle("hidden", r === "admin");
      const tagSelect = document.getElementById(
        "student-tag-select",
      ) as HTMLSelectElement;
      if (tagSelect) tagSelect.value = student.tag || "";
      resetAvatar();
      updateStepUI(1);
      if (formError) {
        formError.classList.add("hidden");
        formError.textContent = "";
      }
      if (modal) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }
    }

    btnOpenModal?.addEventListener("click", openAddModal);
    btnCloseModal?.addEventListener("click", closeModal);
    btnCancelModal?.addEventListener("click", closeModal);

    // Generate random 9-digit decimal UID helper
    btnGenUid?.addEventListener("click", () => {
      const rand = Math.floor(100000000 + Math.random() * 900000000).toString();
      if (uidInput) uidInput.value = rand;
    });

    // Submit Form (Save/Edit)
    studentForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (formError) formError.classList.add("hidden");

      const phoneVal = phoneInput?.value?.trim() || "";
      const phoneCheck = validateWhatsApp(phoneVal);
      if (!phoneCheck.valid) {
        if (formError) {
          formError.textContent = phoneCheck.message;
          formError.classList.remove("hidden");
        }
        updateStepUI(3);
        phoneInput?.focus();
        return;
      }

      const uid = uidInput?.value?.trim().toUpperCase() || "";
      const isExistingAdmin = selectedRole === "admin" && !!idInput?.value;
      if (!uid && !isExistingAdmin) {
        if (formError) {
          formError.textContent =
            "Nomor UID Kartu RFID wajib diisi (ketik manual, scan kartu, atau klik Acak UID Test).";
          formError.classList.remove("hidden");
        }
        uidInput?.focus();
        return;
      }

      const payload = {
        id: idInput?.value || undefined,
        name: nameInput?.value?.trim() || "",
        identifier: identInput?.value?.trim() || "",
        role: selectedRole,
        category:
          catSelect?.value ||
          (selectedRole === "admin"
            ? "admin"
            : selectedRole === "guru"
              ? "guru"
              : "rpl"),
        className: classInput?.value?.trim() || "",
        rfidUid: uid,
        tag:
          (document.getElementById("student-tag-select") as HTMLSelectElement)
            ?.value || "",
        address: addressInput?.value?.trim() || "Padang Ratu, Lampung",
        birthDate: birthInput?.value?.trim() || "",
        email: emailInput?.value?.trim() || "",
        phone: phoneInput?.value?.trim() || "",
      };

      try {
        const res = await fetch("/api/students", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = await res.json();
        if (!res.ok) {
          if (formError) {
            formError.textContent = result.message || "Gagal menyimpan data";
            formError.classList.remove("hidden");
          }
          return;
        }
        closeModal();
        await loadData();
      } catch (err: any) {
        if (formError) {
          formError.textContent = err.message || "Terjadi kesalahan sistem";
          formError.classList.remove("hidden");
        }
      }
    });

    async function deleteStudentItem(id: string) {
      try {
        const res = await fetch("/api/students", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id }),
        });
        if (res.ok) {
          await loadData();
        }
      } catch (e) {
        console.error("Gagal menghapus civitas:", e);
      }
    }

    // Tab Filters
    document.querySelectorAll(".tab-civitas").forEach((tab) => {
      tab.addEventListener("click", () => {
        document.querySelectorAll(".tab-civitas").forEach((t) => {
          t.className =
            "tab-civitas px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all duration-200 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-blue-600";
        });
        tab.className =
          "tab-civitas px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 whitespace-nowrap bg-white text-slate-900 shadow-xs focus:outline-none focus:ring-2 focus:ring-blue-600";
        activeFilter = (tab as HTMLElement).dataset.filter || "all";
        renderTable();
      });
    });

    // Stat Cards Filter click
    document
      .getElementById("card-filter-akl")
      ?.addEventListener("click", () => {
        activeFilter = "akl";
        triggerTabStyle("akl");
        renderTable();
      });
    document
      .getElementById("card-filter-rpl")
      ?.addEventListener("click", () => {
        activeFilter = "rpl";
        triggerTabStyle("rpl");
        renderTable();
      });
    document
      .getElementById("card-filter-guru")
      ?.addEventListener("click", () => {
        activeFilter = "guru";
        triggerTabStyle("guru");
        renderTable();
      });

    function triggerTabStyle(filter: string) {
      document.querySelectorAll(".tab-civitas").forEach((t) => {
        const f = (t as HTMLElement).dataset.filter;
        if (f === filter) {
          t.className =
            "tab-civitas px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 whitespace-nowrap bg-white text-slate-900 shadow-xs focus:outline-none focus:ring-2 focus:ring-blue-600";
        } else {
          t.className =
            "tab-civitas px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all duration-200 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-blue-600";
        }
      });
    }

    // Instant Search
    searchInput?.addEventListener("input", (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      renderTable();
    });

    // SSE Realtime Listener
    window.addEventListener("attendance-updated", loadData);

    // Initial Load
    loadData();
  </script>
</Layout>
